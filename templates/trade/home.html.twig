{% import 'macros/helpers.html.twig' as helpers %}
{% extends 'base.html.twig' %}
{% set breadcrumbs = [
        {label: 'Trade', url: '.'},
    ]
%}

{% block head %}
    <link href="https://unpkg.com/tabulator-tables@6.5.0/dist/css/tabulator.min.css" rel="stylesheet">
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@6.5.0/dist/js/tabulator.min.js"></script>
    <script type="text/javascript" src="/js/trade-home.js"></script>
{% endblock %}
{% block content %}
<h1>Market Trade Activity</h1>

<div class="well flex">
    <button id="clear-good-filter">Show All Goods</button>

    <fieldset>
        <label style="margin-right: 10px;">
            <input type="checkbox" class="type-filter" value="EXPORT" checked> Export
        </label>
        <label style="margin-right: 10px;">
            <input type="checkbox" class="type-filter" value="IMPORT" checked> Import
        </label>
        <label style="margin-right: 10px;">
            <input type="checkbox" class="type-filter" value="EXCHANGE" checked> Exchange
        </label>
    </fieldset>

    <label class="toggle-container">
        <input type="checkbox" id="latest-prices-toggle" checked>
        Show Latest Prices Only
    </label>
</div>

<div class="table" id="trade-data">
</div>
{% endblock %}
