{#
Renders a Ships Orders

Expected parameteers:
    ship: ship value object
    orders: collection of orders for this ship
#}

{% import 'macros/helpers.html.twig' as helpers %}

<table class="ship-orders">
    <tr>
        <th>&nbsp;</th>
        <th>Order</th>
        <th>Status</th>
        <th>Details</th>
        <th>&nbsp;</th>
    </tr>
    {% for order in orders %}
        {% set params = {symbol: ship.symbol, id: order.id} %}
    <tr data-id="{{ order.id }}">
        <td>{{ loop.index }}</td>
        <td>{{ order.type|machine2readable }}
            {{ helpers.play_btn('/ship/order/execute', params, '.ship-order-queue') }}
        </td>
        <td>{{ order.status|machine2readable }}</td>
        <td>{{ order.getPayload() }}</td>
        <td>{{ helpers.delete_btn(
                deleteShipOrderPath(),
                params,
                '.ship-order-queue',
                'Delete Order',
                'Are you sure you want to delete this order?',
            ) }}

           </td>
    </tr>
    {% endfor %}
</table>
