{% macro blank_link(path, text) %}
    <a href="{{ path|e('html_attr') }}"
       target="_blank">{{ text ?: path }}</a>
{% endmacro %}

{% macro modal_link(path, text, cache, target) %}
    <a href="{{ path|e('html_attr') }}"
       up-target="{{ target ?: '.content' }}"
       up-animation="move-from-top"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-layer="swap modal">{{ text ?: path }}</a>
{% endmacro %}

{% macro modal_link_grow(path, text, cache, target) %}
    <a href="{{ path|e('html_attr') }}"
       up-target="{{ target ?: '.content' }}"
       up-size="grow"
       up-animation="move-from-top"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-layer="swap modal">{{ text ?: path }}</a>
{% endmacro %}

{% macro modal_link_large(path, text, cache, target) %}
    <a href="{{ path|e('html_attr') }}"
       up-target="{{ target ?: '.content' }}"
       up-size="large"
       up-animation="move-from-top"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-layer="swap modal">{{ text ?: path }}</a>
{% endmacro %}

{% macro drawer_link(path, text, cache, target) %}
    <a href="{{ path|e('html_attr') }}"
       up-target="{{ target ?: '.content' }}"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-layer="new drawer">{{ text ?: path }}</a>
{% endmacro %}

{% macro drawer_link_grow(path, text, cache, target) %}
    <a href="{{ path|e('html_attr') }}"
       up-target="{{ target ?: '.content' }}"
       up-size="grow"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-layer="new drawer">{{ text ?: path }}</a>
{% endmacro %}

{% macro drawer_link_large(path, text, cache, target) %}
    <a href="{{ path|e('html_attr') }}"
       up-target="{{ target ?: '.content' }}"
       up-size="large"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-layer="new drawer">{{ text ?: path }}</a>
{% endmacro %}

{% macro modal_btn_grow(path, text, cache, target, layer) %}
    <button type="button" class="btn"
       up-href="{{ path|e('html_attr') }}"
       up-follow
       up-active
       up-target="{{ target ?: '.content' }}"
       up-size="grow"
       up-animation="move-from-top"
       up-cache="{{ cache ? 'true' : 'false' }}"
       up-mode="modal"
       up-layer="{{ layer ?: 'swap modal' }}">{{ text ?: path }}</button>
{% endmacro %}

{% macro link(path, text) %}
    <a href="{{ path }}">{{ text ?: path }}</a>
{% endmacro %}

{% macro select_options(options) %}
    {% for opt in options %}
        <option value="{{ opt.value|e('html_attr') }}">{{ opt.name }}</option>
    {% endfor %}
{% endmacro %}

{% macro play_btn(href, params, target, title, confirm) %}
    <button type="button"
            title="{{ title ?: 'Execute' }}"
            up-follow
            up-method="POST"
            {% if target %}
            up-target="{{ target }}"
            {% endif %}
            up-layer="any"
            up-fallback="false"
            up-abort="false"
            up-flock="false"
            up-transition="none"
            up-href="{{ href }}"
            up-params="{{ params|json_encode }}"
            class="btn-icon btn-play"
            aria-label="{{ title ?: 'Execute' }}">
    {{ _self.icon_play(18) }}
    </button>
{% endmacro %}

{% macro delete_btn(href, params, target, title, confirm) %}
    <button type="button"
            title="{{ title ?: 'Delete this' }}"
            up-confirm="{{ confirm ?: 'Are you sure you want to delete?' }}"
            up-follow
            up-method="DELETE"
            up-target="{{ target }}"
            up-href="{{ href }}"
            up-params="{{ params|json_encode }}"
            class="btn-icon btn-delete" aria-label="{{ title ?: 'Delete' }} ">
    {{ _self.icon_trash(18) }}
    </button>
{% endmacro %}

{% macro icon_trash(size = 16) %}
    <svg aria-hidden="true"
         xmlns="http://www.w3.org/2000/svg"
         width="{{ size }}"
         height="{{ size }}"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
        <path d="M3 6h18"></path>
        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
    </svg>
{% endmacro %}

{% macro icon_play(size = 16) %}
    <svg aria-hidden="true"
         xmlns="http://www.w3.org/2000/svg"
         width="16"
         height="16"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
        <polygon points="6 3 20 12 6 21 6 3"></polygon>
    </svg>
{% endmacro %}
